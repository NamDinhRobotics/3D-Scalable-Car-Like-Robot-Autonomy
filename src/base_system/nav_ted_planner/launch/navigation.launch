<launch>

  <!-- AMCL: Localization using the occupancy grid map  -51.224998, -51.224998, 0.000000  -->
    <node pkg="amcl" type="amcl" name="amcl">
        <remap from="scan" to="scan_cloud"/>
        <param name="odom_frame_id" value="odom" />
        <param name="base_frame_id" value="base_link" />
        <param name="global_frame_id" value="map" />
        <param name="initial_pose_x" value="0.22" />
        <param name="initial_pose_y" value="0.22" />
        <param name="initial_pose_a" value="0.0" />
        <param name="initial_cov_xx" value="0.5" />
        <param name="initial_cov_yy" value="0.5" />
        <param name="initial_cov_aa" value="0.5" />
        <!-- Odometry tuning -->
        <param name="odom_model_type" value="diff" />
        <param name="odom_alpha1" value="0.2" />
        <param name="odom_alpha2" value="0.2" />
        <param name="odom_alpha3" value="0.2" />
        <param name="odom_alpha4" value="0.2" />
        <param name="odom_frame_rate" value="20.0" />
        <!-- Particle filter -->
        <param name="min_particles" value="500" />
        <param name="max_particles" value="5000" />
        <param name="update_min_d" value="0.1" />
        <param name="update_min_a" value="0.2" />
        <param name="resample_interval" value="1" />
    </node>

  
  <!-- <node pkg="tf" type="static_transform_publisher" name="sensorToLaser" args="0 0 0 0 0 0 /map /odom 1000"/> -->


  <!-- Move Base: Navigation stack -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find nav_ted_planner)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find nav_ted_planner)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find nav_ted_planner)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find nav_ted_planner)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find nav_ted_planner)/config/global_planner_params.yaml" command="load" />

    <rosparam file="$(find nav_ted_planner)/config/teb_local_planner_params.yaml" command="load" />
    <rosparam file="$(find nav_ted_planner)/config/navfn_params.yaml" command="load" />
    <param name="base_global_planner" value="navfn/NavfnROS" /> 
    <!-- <param name="base_global_planner" value="global_planner/GlobalPlanner" /> --> <!-- Enable if using A star-->
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="controller_frequency" value="10.0" />
  </node>

!-- Launch the twist_to_ackermann node -->
    <node pkg="nav_ted_planner" type="twist_to_ackermann" name="twist_to_ackerman_cmd" output="screen">

        <!-- Set parameters -->
        <param name="wheelbase" value="0.36" />
        <param name="twist_cmd_topic" value="cmd_vel" />
        <param name="ackermann_cmd_topic" value="ackermann_cmd" />
        <param name="frame_id" value="odom" />
    </node>

<!-- Launch the twist_to_ackermann node
    <node pkg="nav_ted_planner" type="twist_to_ackermann" name="twist_to_ackermann" output="screen">

        <remap from="/cmd_vel" to="/cmd_vel" />
        <remap from="/ackermann_cmd" to="/ackermann_drive" />

        <param name="wheelbase" value="0.36" />
        <param name="twist_cmd_topic" value="/cmd_vel" />
        <param name="ackermann_cmd_topic" value="/ackermann_drive" />
        <param name="frame_id" value="odom" />
    </node>
  
-->

</launch>
